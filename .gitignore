# TO-ANISOTROPIC repository hygiene

# --- local build artifacts (sandbox-safe workspace build) ---
build/

# --- OpenFOAM build leftovers ---
src/validation_stage_*.log
src/Make/linux64Gcc*/
*.o
*.dep
*.obj
*.exe

# --- heavy / regenerable solver evidence ---
# Matrix-market exports are large (explicitJT.mtx can exceed GitHub's 100 MB
# per-file limit) and are regenerated by the diagnostic runs; only the final
# reports / small logs / scripts are tracked.
*.mtx
*.mat

# --- Python virtualenvs (never commit) ---
.venv*/
venv/
__pycache__/
*.pyc
*.pyo
*.pyi
*.so
*.f90
*.f
*.sav
*.wav
*.npz

# --- Windows metadata junk ---
*:Zone.Identifier
